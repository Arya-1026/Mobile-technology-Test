rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin() || request.auth.uid == uid;
    }
    match /competitions/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.ownerId;
    }
    match /registrations/{id} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
