rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isCompetitionOwner(competitionId) {
      return signedIn() &&
        get(/databases/$(database)/documents/competitions/$(competitionId)).data.ownerId == request.auth.uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Competitions ───────────────────────────────────────────────────────
    match /competitions/{id} {
      // Only approved competitions visible to all; organizers see their own
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin() || request.auth.uid == resource.data.ownerId;
      allow delete: if isAdmin() || request.auth.uid == resource.data.ownerId;
    }

    // ── Participation requests (competitionRequests) ────────────────────────
    match /competitionRequests/{id} {
      // Participant can read their own; competition owner and admin can read all
      allow read: if signedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.ownerId
      );
      allow create: if signedIn();
      // Organizer or admin can update status
      allow update: if isAdmin() || request.auth.uid == resource.data.ownerId;
      allow delete: if isAdmin();
    }

    // ── Organizer requests ─────────────────────────────────────────────────
    match /teams/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.leaderId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if signedIn() && resource.data.leaderId == request.auth.uid;
    }

    match /teamInvites/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.leaderId ||
        request.auth.token.email == resource.data.toEmail
      );
      allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.leaderId ||
        request.auth.token.email == resource.data.toEmail
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.leaderId;
    }

    match /teamNotifications/{id} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /registeredCompetitions/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /bracketMatches/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin() || isCompetitionOwner(resource.data.competitionId);
    }

    match /matchResults/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin() || isCompetitionOwner(resource.data.competitionId);
    }

    match /organizerRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Legacy registrations ───────────────────────────────────────────────
    match /registrations/{id} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
